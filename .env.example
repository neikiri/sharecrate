#-----------------------------------------------------------------------
# ShareCrate - runtime configuration
# Copy this file to .env in the document root and fill in the values.
# The web installer (/install/) can generate this file for you.
#-----------------------------------------------------------------------

APP_NAME="ShareCrate"
APP_URL="https://example.com"

# production | local
APP_ENV=production
APP_DEBUG=false

# Leave empty when the site lives in the document root.
# Use "/subfolder" when it is installed in a subdirectory.
APP_BASE_PATH=

# 64 hex characters. Used for signing tokens and hashing IP addresses.
APP_KEY=

#--- Database ----------------------------------------------------------
DB_HOST=localhost
DB_PORT=3306
DB_NAME=sharecrate
DB_USER=
DB_PASS=
DB_CHARSET=utf8mb4

#--- Storage -----------------------------------------------------------
# Directory that receives the files (also the FTP upload target).
# Relative paths are resolved from the document root.
STORAGE_PATH=storage/uploads

#--- Localisation ------------------------------------------------------
# Locale used when the visitor country is not in CZECH_COUNTRIES.
DEFAULT_LOCALE=en
# Visitors from these countries get the Czech version.
CZECH_COUNTRIES=CZ,SK

# auto | cloudflare | server | api | none
GEOIP_PROVIDER=auto

#--- Networking --------------------------------------------------------
# Comma separated list of reverse proxy IPs allowed to set X-Forwarded-For.
TRUSTED_PROXIES=

#--- Session -----------------------------------------------------------
SESSION_NAME=sharecrate_sid
SESSION_LIFETIME=7200
